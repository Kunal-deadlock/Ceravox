CERAVOX_APP_NAME=Ceravox API
CERAVOX_ENVIRONMENT=development
CERAVOX_LOG_LEVEL=INFO
CERAVOX_DATABASE_URL=sqlite:///./ceravox.db
CERAVOX_OLLAMA_URL=http://127.0.0.1:11434
CERAVOX_SESSION_TTL_SECONDS=28800
CERAVOX_COOKIE_SECURE=false
CERAVOX_ASR_MODEL=base
CERAVOX_ASR_MODEL_DIR=./models/faster-whisper-base
CERAVOX_ASR_DEVICE=cpu
CERAVOX_ASR_COMPUTE_TYPE=int8
CERAVOX_ASR_CPU_THREADS=2
CERAVOX_TTS_MODEL=Kokoro-82M
CERAVOX_TTS_MODEL_DIR=./models/kokoro
CERAVOX_TTS_VOICES_DIR=./models/kokoro/voices
CERAVOX_TTS_VOICES=["af_heart"]
CERAVOX_TTS_DEFAULT_VOICE=af_heart
CERAVOX_AUDIO_STORAGE_DIR=./recordings/tmp
CERAVOX_AUDIO_MAX_UPLOAD_BYTES=26214400
CERAVOX_AUDIO_MAX_REQUEST_BYTES=27262976
CERAVOX_AUDIO_MAX_DURATION_SECONDS=600
CERAVOX_TTS_MAX_TEXT_CHARS=2000
CERAVOX_TTS_MAX_AUDIO_SECONDS=300
