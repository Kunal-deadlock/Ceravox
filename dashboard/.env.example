# Frontend (Vercel) environment variable
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# to the public URL where your FastAPI backend is reachable.
# Example (Cloudflare quick tunnel): VITE_API_BASE_URL=https://your-tunnel.trycloudflare.com
# Leave empty only if running both frontend and backend on the same origin (local dev with Vite proxy).
VITE_API_BASE_URL=
